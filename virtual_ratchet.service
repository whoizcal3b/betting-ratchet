[Unit]
Description=Virtual Ratchet 24/7 High-Water Mark Automated Betting Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/betting-ratchet
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/pkill -9 -f chrome-headless || true
ExecStart=/home/ubuntu/betting-ratchet/venv/bin/python3 -u /home/ubuntu/betting-ratchet/bot.py
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
