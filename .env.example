# ==============================================================================
# VIRTUAL RATCHET BOT: CONFIGURATION TEMPLATE
# ==============================================================================

# Execution Mode:
# 'PAPER' = Unconstrained 24/7 simulation to stress-test true historical MDD.
# 'LIVE'  = Real bets submitted to SportyBet betslip.
BOT_MODE=PAPER

# Mathematical Staking Settings:
STARTING_BALANCE=1000.0
DIVISOR=15.0
TARGET_ODDS_MIN=2.80

# SportyBet Autonomous Login Credentials (Optional - used to auto-login if session drops):
SPORTYBET_PHONE=your_phone_number_here
SPORTYBET_PASSWORD=your_password_here

# Telegram Notification Settings:
# Get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=1234567890:AAH...your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Telegram Alerts Toggles:
TELEGRAM_NOTIFY_MILESTONES=True
TELEGRAM_MILESTONE_STEP_PCT=100.0    # Sends alert every 100% gain (+100%, +200%, +300%...)
TELEGRAM_NOTIFY_BUST=True            # Sends alert if live account goes bust
TELEGRAM_NOTIFY_ERRORS=True          # Sends errors directly to your Telegram

# Performance & Automation Settings:
HEADLESS=True
MUTE_AUDIO=True
BLOCK_MEDIA=True

# Optional: Reset database journal on start (True/False)
RESET_DB_ON_START=False
